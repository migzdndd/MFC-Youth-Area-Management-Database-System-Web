# ===================================================
# MFC Youth AMS - Environment Variables Template
# ===================================================
# Copy this file to .env.local for local development.
# In Vercel, add these under Project Settings > Environment Variables.

# [CONFIG - Plain Text] Supabase Project URL
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# [CONFIG - Plain Text] Supabase Publishable / Anon Key (client-safe)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY

# [SECRET - Sensitive] Supabase Service Role Secret Key (bypasses RLS)
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_KEY

# [SECRET - Sensitive] Private registration passcode for Servant Leaders
ADMIN_REGISTRATION_CODE=CHANGE_THIS_TO_A_PRIVATE_CODE
